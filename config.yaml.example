# Name of the YNAB budget to target. When multiple budgets have this name,
# the script uses the most recently modified one.
budgetName: Demo Family Budget

# Exact YNAB account name that funds allowance and interest transfers.
allowanceEscrowAccountName: Allowance Escrow

# Exact YNAB category name used for the offsetting transaction that balances
# the allowance/interest postings.
allowanceCategoryName: Family Allowance

# Memo text used on generated interest transactions.
interestMemo: Interest

# Memo text used on generated allowance deposit transactions.
allowanceMemo: Allowance

# Memo text used on the offsetting transaction created from the allowance
# category.
combinedMemo: Allowance and Interest combined

# Suffix appended in memos for kids who receive one combined non-interest-
# bearing allowance transaction instead of per-account interest.
nonInterestMemoSuffix: Piggy Banks

# -----------------------------------------------------------------------------
# Simple-account configuration
# -----------------------------------------------------------------------------
# Use this section for kids whose allowance is derived from bank suffixes plus a
# standard weekly amount per suffix. For each kid in kidsWithSimpleAccounts, the
# script expects categories such as "<Kid> Spend Bank", "<Kid> Save Bank", and
# "<Kid> Give Bank".

# Category-name suffixes for simple-account kids. These are appended to each
# kid name to locate the matching YNAB categories.
bankSuffixes:
  - " Spend Bank"
  - " Save Bank"
  - " Give Bank"

# Weekly allowance amounts, in dollars, for simple-account categories keyed by
# the matching bank suffix.
allowanceRates:
  " Spend Bank": 1.0
  " Save Bank": 0.5
  " Give Bank": 0.5

# Kids whose allowance is generated from bankSuffixes + allowanceRates.
kidsWithSimpleAccounts: []

# Kids who receive one combined weekly allowance transaction and no interest
# transactions.
kidsWithoutInterest: []

# Weekly give-bank amount, in dollars, used when generating a single combined
# non-interest-bearing transaction.
giveBankRate: 0.5

# -----------------------------------------------------------------------------
# Advanced-account configuration
# -----------------------------------------------------------------------------
kidsWithAdvancedAccounts:
  - Child One
  - Child Two
  - Child Three
  - Child Four

advancedAllowanceDeposits:
  Child One:
    "Child One Silver Account": 3.0
    "Child One Give Bank": 0.5
  Child Two:
    "Child Two Silver Account": 3.0
    "Child Two Give Bank": 0.5
  Child Three:
    "Child Three Silver Account": 1.0
    "Child Three Give Bank": 0.5
  Child Four:
    "Child Four Silver Account": 1.0
    "Child Four Bronze Account": 0.5
    "Child Four Give Bank": 0.5

accountTypes:
  - Bronze
  - Silver
  - Gold CD 2-Month
  - Gold CD 3-Month
  - Gold CD 6-Month
  - First Car Fund

interestRatesByAccountTypeAndDate:
  Current:
    Bronze: 0.1
    Silver: 0.15
    Gold CD 2-Month: 0.25
    Gold CD 3-Month: 0.35
    Gold CD 6-Month: 0.65
    First Car Fund: 0.65
  "2025-06-01":
    Bronze: 0.1
    Silver: 0.5
    Gold CD 2-Month: 0.75
    Gold CD 3-Month: 1.0
    Gold CD 6-Month: 1.25
    First Car Fund: 1.25
  "2025-04-14":
    Bronze: 0.25
    Silver: 0.75
    Gold CD 2-Month: 1.5
    Gold CD 3-Month: 1.75
    Gold CD 6-Month: 2.0
    First Car Fund: 2.0
  "2024-12-25":
    Gold CD 2-Month: 1.75
    Gold CD 3-Month: 2.0
    Gold CD 6-Month: 2.25
  "2024-11-23":
    Gold CD 2-Month: 2.25
    Gold CD 3-Month: 2.5
    Gold CD 6-Month: 2.75

# -----------------------------------------------------------------------------
# Parent/child syncer configuration
# -----------------------------------------------------------------------------
# This section is used only by the standalone ParentChildBudgetSyncer entry point.
# Tokens stay out of YAML; each budget names the environment variable that holds
# its YNAB access token.
sync:
  parentBudget:
    budgetName: Demo Parent Budget
    tokenEnvVarName: YNAB_PARENT_TOKEN

  childBudgets:
    # Optional per child. Defaults are memoPrefix: "YBOD: " and memoSuffix: "".
    # The final prefix + source memo + suffix value is trimmed. These settings
    # affect synced child transactions only; each created child transaction is cleared.
    - childKey: child-one
      budgetName: Demo Child One Budget
      tokenEnvVarName: YNAB_CHILD_ONE_TOKEN
      memoPrefix: "YBOD: "
      memoSuffix: ""
      accountMappings:
        - mappingKey: spend-save
          parentCategoryNames:
            - name: "Child One Spend Bank"
            - name: "Child One Save Bank"
          childAccountName: Child One Checking
        - mappingKey: cd
          parentCategoryNames:
            - name: "Child One Gold CD.*"
              regex: true
          childAccountName: Child One CD Account
    - childKey: child-two
      budgetName: Demo Child Two Budget
      tokenEnvVarName: YNAB_CHILD_TWO_TOKEN
      memoPrefix: "[Child Two] "
      memoSuffix: " (synced)"
      accountMappings:
        - mappingKey: spend
          parentCategoryNames:
            - name: "Child Two Spend Bank"
          childAccountName: Child Two Checking

  # Continuous polling interval in seconds.
  pollingIntervalSeconds: 300

  logging:
    # Rolling file target for sync runs.
    filePath: logs/parent-child-sync.log
    # Allowed values: TRACE, DEBUG, INFO, WARN, ERROR.
    level: INFO
    # Number of historical log files to retain.
    maxHistory: 7
    # Maximum file size, in MB, before rolling.
    maxFileSizeMb: 10

  state:
    # Default SQLite replay-protection database path.
    sqlitePath: syncstate.db
    # How many days of parent transactions to reread safely.
    transactionLookbackDays: 45
    # How many days of money movements to reread before YNAB ages them out.
    moneyMovementLookbackDays: 45
